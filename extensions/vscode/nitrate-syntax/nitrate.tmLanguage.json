{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Nitrate",
    "scopeName": "source.nit",
    "patterns": [
        {
            "include": "#COMMENT"
        },
        {
            "include": "#STRING"
        },
        {
            "include": "#NUMBER"
        },
        {
            "include": "#KEYWORD"
        },
        {
            "include": "#OPERATOR"
        },
        {
            "include": "#PUNCTUATION"
        },
        {
            "include": "#IDENTIFIER"
        }
    ],
    "repository": {
        "COMMENT": {
            "patterns": [
                {
                    "name": "comment.block.nit",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.line.nit",
                    "match": "(//|#).*$"
                }
            ]
        },
        "STRING": {
            "patterns": [
                {
                    "name": "string.quoted.double.nit",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.nit",
                            "match": "\\\\[0abtnvfr\\\\\"']"
                        },
                        {
                            "name": "constant.character.escape.nit",
                            "match": "\\\\x[0-9a-fA-F]{2}"
                        },
                        {
                            "name": "constant.character.escape.nit",
                            "match": "\\\\o[0-7]{3}"
                        },
                        {
                            "name": "constant.character.escape.nit",
                            "match": "\\\\u\\{U\\+[0-9a-fA-F]{1,8}\\}"
                        },
                        {
                            "name": "constant.character.escape.nit",
                            "match": "\\\\u\\{[0-9a-fA-F]{1,8}\\}"
                        }
                    ]
                }
            ]
        },
        "NUMBER": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.nit",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.integer.nit",
                    "match": "\\b0o[0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.integer.nit",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.numeric.integer.nit",
                    "match": "\\b0d[0-9_]+\\b"
                },
                {
                    "name": "constant.numeric.float.nit",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
                },
                {
                    "name": "constant.numeric.integer.nit",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "KEYWORD": {
            "patterns": [
                {
                    "name": "storage.type.declaration.nit",
                    "match": "\\b(fn|enum|struct|class|union|contract|trait|impl|type|scope|use|mod)\\b"
                },
                {
                    "name": "storage.type.variable.nit",
                    "match": "\\b(let|var)\\b"
                },
                {
                    "name": "storage.modifier.nit",
                    "match": "\\b(safe|unsafe|promise|static|mut|const|poly|iso|pub|sec|pro)\\b"
                },
                {
                    "name": "keyword.control.nit",
                    "match": "\\b(if|else|for|in|while|do|match|break|continue|ret|async|await|asm|extern)\\b"
                },
                {
                    "name": "constant.language.nit",
                    "match": "\\b(null|true|false)\\b"
                },
                {
                    "name": "storage.type.primitive.nit",
                    "match": "\\b(bool|u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|f8|f16|f32|f64|f128|opaque)\\b"
                },
                {
                    "name": "keyword.operator.nit",
                    "match": "\\b(as|typeof)\\b"
                },
                {
                    "name": "entity.name.type.nit",
                    "match": "\\bSelf\\b"
                },
                {
                    "name": "variable.language.nit",
                    "match": "\\bself\\b"
                }
            ]
        },
        "OPERATOR": {
            "patterns": [
                {
                    "name": "keyword.operator.nit",
                    "match": "(<<<=|>>>=|<<=|>>=|<<<|>>>|&&=|\\|\\|=|&&|\\|\\||<<|>>|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\.\\.|->|~|\\?|!|%|\\+|-|\\*|/|&|\\||\\^|=|<|>)"
                }
            ]
        },
        "PUNCTUATION": {
            "patterns": [
                {
                    "name": "punctuation.separator.nit",
                    "match": "[;,:]"
                },
                {
                    "name": "punctuation.accessor.nit",
                    "match": "\\."
                },
                {
                    "name": "punctuation.section.parens.nit",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.section.brackets.nit",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.section.block.nit",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.other.nit",
                    "match": "['@$]"
                }
            ]
        },
        "IDENTIFIER": {
            "patterns": [
                {
                    "name": "variable.other.atypical.nit",
                    "begin": "`",
                    "end": "`"
                },
                {
                    "name": "variable.other.nit",
                    "match": "([A-Za-z_]|[^\\x00-\\x7F])([A-Za-z0-9_]|[^\\x00-\\x7F])*"
                }
            ]
        }
    }
}